@page
@model MediCare.App.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - ForestView Hospital</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="auth.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="auth-page">
        <div class="auth-container">
            <div class="auth-left">
                <div class="auth-brand">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" stroke="#00A8A8" stroke-width="2" />
                        <path d="M12 8V16M8 12H16" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <div>
                        <h1><strong>ForestView</strong></h1>
                        <p>Hospital</p>
                    </div>
                </div>
                <div class="auth-illustration">
                    <div class="illustration-circle"></div>
                    <div class="illustration-text">
                        <h2>Join Us Today!</h2>
                        <p>Create an account to access our comprehensive healthcare services</p>
                    </div>
                </div>
            </div>

            <div class="auth-right">
                <div class="auth-form-container">
                    <div class="auth-header">
                        <h2>Create Account</h2>
                        <p>Fill in your details to get started</p>
                    </div>

                    <!-- Register.cshtml -->
                    <form class="auth-form" method="post" asp-route-returnUrl="/Patient/Dashboard">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Input.FullName">Full Name</label>
                            <div class="input-wrapper">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="input-icon">
                                    <circle cx="10" cy="7" r="3" stroke="#00A8A8" stroke-width="1.5" />
                                    <path d="M5 15c0-2.5 2-4 5-4s5 1.5 5 4" stroke="#00A8A8" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <input asp-for="Input.FullName" placeholder="Enter your full name" required />
                            </div>
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="form-group">
                            <label asp-for="Input.Email">Email Address</label>
                            <div class="input-wrapper">
                                <!-- keep your SVG -->
                                <input asp-for="Input.Email" id="regEmail" placeholder="Enter your email" class="form-control" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="form-group">
                            <label asp-for="Input.Password">Password</label>
                            <div class="input-wrapper">
                                <!-- keep your SVG -->
                                <input asp-for="Input.Password" id="regPassword" placeholder="Create a password" class="form-control" />
                                <button type="button" class="toggle-password" onclick="togglePassword('regPassword')">…</button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <div class="input-wrapper">
                                <!-- keep your SVG -->
                                <input asp-for="Input.ConfirmPassword" id="confirmPassword" placeholder="Confirm your password" class="form-control" />
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Terms (optional, not bound) -->
                        <div class="form-options">
                            <label class="checkbox-label">
                                <input type="checkbox" id="terms" required>
                                <span>I agree to the <a href="#">Terms & Conditions</a></span>
                            </label>
                        </div>

                        <button type="submit" class="auth-submit-btn">
                            Create Account
                            <!-- your SVG -->
                        </button>

                        <div class="auth-footer">
                            <p>
                                Already have an account?
                                <a asp-area="Identity" asp-page="/Account/Login">Log in here</a>
                            </p>
                        </div>
                    </form>

                    @section Scripts {
                        <partial name="_ValidationScriptsPartial" />
                    }

                    <a asp-controller="Home" asp-action="Index" class="back-home">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M15 10H5M8 7l-3 3 3 3" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        Back to Home
                    </a>

                </div>
            </div>
        </div>
    </div>

    <script src="auth.js"></script>
</body>
</html>
