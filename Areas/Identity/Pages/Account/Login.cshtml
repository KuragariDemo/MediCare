@page
@model MediCare.App.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ForestView Hospital</title>
    <link rel="stylesheet" href="~/css/globals.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="auth-page">
        <div class="auth-container">
            <div class="auth-left">
                <div class="auth-brand">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" stroke="#00A8A8" stroke-width="2" />
                        <path d="M12 8V16M8 12H16" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <div>
                        <h1><strong>ForestView</strong></h1>
                        <p>Hospital</p>
                    </div>
                </div>
                <div class="auth-illustration">
                    <div class="illustration-circle"></div>
                    <div class="illustration-text">
                        <h2>Welcome Back!</h2>
                        <p>Access your health records and manage appointments</p>
                    </div>
                </div>
            </div>

            <div class="auth-right">
                <div class="auth-form-container">
                    <div class="auth-header">
                        <h2>Log In</h2>
                        <p>Enter your credentials to access your account</p>
                    </div>

                    <!-- IMPORTANT: post to this Razor Page + carry ReturnUrl -->
                    <form class="auth-form" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <!-- Validation summary -->
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Input.Email">Email Address</label>
                            <div class="input-wrapper">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="input-icon">
                                    <path d="M3 4h14a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1z" stroke="#00A8A8" stroke-width="1.5" />
                                    <path d="M2 5l8 5 8-5" stroke="#00A8A8" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <input asp-for="Input.Email" id="email" placeholder="Enter your email" class="form-control" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Password">Password</label>
                            <div class="input-wrapper">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="input-icon">
                                    <rect x="4" y="9" width="12" height="8" rx="1" stroke="#00A8A8" stroke-width="1.5" />
                                    <path d="M7 9V6a3 3 0 016 0v3" stroke="#00A8A8" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <input asp-for="Input.Password" id="password" placeholder="Enter your password" class="form-control" />
                                <button type="button" class="toggle-password" onclick="togglePassword('password')">
                                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                        <path d="M10 7a3 3 0 100 6 3 3 0 000-6z" stroke="#999" stroke-width="1.5" />
                                        <path d="M10 3C5 3 2 10 2 10s3 7 8 7 8-7 8-7-3-7-8-7z" stroke="#999" stroke-width="1.5" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-options">
                            <label class="checkbox-label">
                                <input asp-for="Input.RememberMe" id="remember" />
                                <span>Remember me</span>
                            </label>
                            <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="forgot-link">Forgot Password?</a>
                        </div>

                        <button type="submit" class="auth-submit-btn">
                            Log In
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path d="M5 10h10M12 7l3 3-3 3" stroke="white" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>

                        <div class="auth-footer">
                            <p>Don't have an account?
                                <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Register here</a>
                            </p>
                        </div>
                    </form>

                    <a asp-controller="Home" asp-action="Index" class="back-home">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M15 10H5M8 7l-3 3 3 3" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
