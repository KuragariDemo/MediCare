@model string
@using Microsoft.AspNetCore.Identity
@using MediCare.App.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var fullName = user?.FullName ?? user?.UserName ?? "Admin";
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
    var roleLabel = roles.Contains("AdminPlus") ? "Administrator" : roles.Contains("Admin") ? "Co.Administrator" : "Admin";

    string MakeInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AD";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpperInvariant();
    }
}

<header class="dashboard-header">
    <div class="header-left">
        <h1>Admin Dashboard</h1>
        <p>@(string.IsNullOrWhiteSpace(Model) ? "Hospital Management Overview" : Model)</p>
    </div>
    <div class="header-right">
        <div class="user-profile">
            <div class="user-avatar">@MakeInitials(fullName)</div>
            <div class="user-info">
                <p class="user-name">@fullName</p>
                <p class="user-role">@roleLabel</p>
            </div>
        </div>
    </div>
</header>
