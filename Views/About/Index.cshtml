@{
    ViewData["Title"] = "About Us - ForestView Hospital";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/globals.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <partial name="_PublicHeader" />

    <!-- About Hero -->
    <section class="page-hero">
        <div class="container">
            <h1>About ForestView Hospital</h1>
            <p>Your trusted partner in healthcare excellence</p>
        </div>
    </section>

    <!-- Mission Section -->
    <section class="content-section">
        <div class="container">
            <div class="content-grid">
                <div class="content-text">
                    <h2>Our Mission</h2>
                    <p>At ForestView Hospital, we are committed to providing exceptional healthcare services with compassion, innovation, and excellence. Our mission is to improve the health and well-being of our community through comprehensive medical care.</p>
                    <p>We believe in treating every patient with dignity and respect, ensuring they receive personalized care tailored to their unique needs.</p>
                </div>
                <div class="content-image">
                    <div class="placeholder-image">🏥</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="values-section">
        <div class="container">
            <h2 class="section-title">Our Core Values</h2>
            <div class="values-grid">
                <div class="value-card">
                    <div class="value-icon">💙</div>
                    <h3>Compassion</h3>
                    <p>We treat every patient with empathy, kindness, and understanding.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">⭐</div>
                    <h3>Excellence</h3>
                    <p>We strive for the highest standards in medical care and service.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🤝</div>
                    <h3>Integrity</h3>
                    <p>We maintain honesty and transparency in all our interactions.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🔬</div>
                    <h3>Innovation</h3>
                    <p>We embrace cutting-edge technology and medical advancements.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="about-stats">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item">
                    <h3>25+</h3>
                    <p>Years of Service</p>
                </div>
                <div class="stat-item">
                    <h3>50+</h3>
                    <p>Expert Doctors</p>
                </div>
                <div class="stat-item">
                    <h3>12K+</h3>
                    <p>Happy Patients</p>
                </div>
                <div class="stat-item">
                    <h3>15+</h3>
                    <p>Specialties</p>
                </div>
            </div>
        </div>
    </section>

    <partial name="_PublicFooter" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
