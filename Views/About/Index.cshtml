<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="logo">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="#00A8A8" stroke-width="2" />
                    <path d="M12 8V16M8 12H16" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                </svg>
                <span class="logo-text"><strong>ForestView</strong><br />Hospital</span>
            </div>
            <nav class="nav">
                <a href="index.html" class="nav-link">Home</a>
                <a href="about.html" class="nav-link active">About</a>
                <a href="doctors.html" class="nav-link">Doctors</a>
                <a href="contact.html" class="nav-link">Contact</a>
            </nav>
            <div class="auth-buttons">
                <button class="register-btn">Register</button>
                <button class="login-btn">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="7" stroke="white" stroke-width="1.5" />
                    </svg>
                    Log in
                </button>
            </div>
        </div>
