@model MediCare.App.ViewModels.Patient.PatientDashboardVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_PatientLayout";
}

<div class="dashboard-container">
    @await Html.PartialAsync("_PatientSidebar")

    <main class="dashboard-main">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-left">
                <h1>Welcome, @Model.DisplayName!</h1>
                <p>Manage your health records and appointments</p>
            </div>
            <div class="header-right">
                <div class="user-profile">
                    <div class="user-avatar">@Model.Initials</div>
                    <div class="user-info">
                        <p class="user-name">@Model.DisplayName</p>
                        <p class="user-role">@(Model.PatientId > 0 ? $"Patient ID: #{Model.PatientId}" : "Patient")</p>
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="dashboard-content" id="home-section">

            <!-- Quick Actions -->
            <div class="quick-actions">
                <button class="quick-action-btn" onclick="window.location.href='@Url.Action("Index", "Appointment")'">
                    <span class="action-icon">📅</span><span>Book Appointment</span>
                </button>
                <button class="quick-action-btn" onclick="window.location.href='@Url.Action("My", "PatientAppointments")'">
                    <span class="action-icon">🗓️</span><span>My Appointments</span>
                </button>
                <button class="quick-action-btn" onclick="window.location.href='@Url.Action("Recent", "PatientAppointments")'">
                    <span class="action-icon">📋</span><span>Prescriptions &amp; Feedback</span>
                </button>
                <button class="quick-action-btn" onclick="window.location.href='@Url.Action("Index", "PatientProfile")'">
                    <span class="action-icon">👤</span><span>My Profile</span>
                </button>
            </div>

            <!-- Summary Cards -->
            <div class="stats-grid">
                <div class="stat-card highlight">
                    <div class="stat-icon blue">📅</div>
                    <div class="stat-info">
                        @if (Model.NextAppointment is { } next)
                        {
                            <h3>Next Appointment</h3>
                            <p>@next.DutyDate.ToString("dd MMM yyyy") - @next.StartTime.ToString(@"hh\:mm")</p>
                            <small>Dr. @next.DoctorName - @next.DoctorSpecialty</small>
                        }
                        else
                        {
                            <h3>No Upcoming Appointments</h3>
                            <p><a href="@Url.Action("Index", "Appointment")">Book one now</a></p>
                        }
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon orange">🗓️</div>
                    <div class="stat-info">
                        <h3>@Model.UpcomingAppointmentsCount</h3>
                        <p>Upcoming Appointments</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon red">💳</div>
                    <div class="stat-info">
                        <h3>@Model.UnpaidBillsTotal.ToString("C")</h3>
                        <p>@Model.UnpaidBillsCount Unpaid Bill@(Model.UnpaidBillsCount == 1 ? "" : "s")</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green">💊</div>
                    <div class="stat-info">
                        <h3>@Model.PrescriptionsCount</h3>
                        <p>Prescriptions on File</p>
                    </div>
                </div>
            </div>

            <!-- Upcoming Appointments -->
            <div class="content-section">
                <div class="section-header">
                    <h2>Upcoming Appointments</h2>
                    <button class="btn-primary" onclick="window.location.href='@Url.Action("Index", "Appointment")'">Book New</button>
                </div>

                @if (Model.UpcomingAppointments.Any())
                {
                    <div class="appointments-list">
                        @foreach (var a in Model.UpcomingAppointments)
                        {
                            <div class="appointment-card">
                                <div class="appointment-date">
                                    <div class="date-day">@a.DutyDate.Day</div>
                                    <div class="date-month">@a.DutyDate.ToString("MMM").ToUpper()</div>
                                </div>
                                <div class="appointment-details">
                                    <h4>Dr. @a.DoctorName</h4>
                                    <p>@a.DoctorSpecialty</p>
                                    <div class="appointment-meta">
                                        <span>⏰ @a.StartTime.ToString(@"hh\:mm") - @a.EndTime.ToString(@"hh\:mm")</span>
                                        <span>📍 @a.Branch</span>
                                    </div>
                                </div>
                                <div class="appointment-actions">
                                    <button class="btn-secondary" onclick="window.location.href='@Url.Action("My", "PatientAppointments")'">Manage</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-state">You have no upcoming appointments. <a href="@Url.Action("Index", "Appointment")">Book one now</a>.</p>
                }
            </div>

        </div><!-- /.dashboard-content -->
    </main>
</div><!-- /.dashboard-container -->
