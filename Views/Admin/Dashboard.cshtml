@model MediCare.App.ViewModels.Admin.AdminDashboardVM
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";

    var maxDay = Model.Last7Days.Any() ? Math.Max(1, Model.Last7Days.Max(d => d.Count)) : 1;
}
<div class="dashboard-container">
    <!-- Sidebar -->
    @await Html.PartialAsync("_AdminSidebar")

    <!-- Main Content -->
    <main class="dashboard-main">
        <partial name="_AdminHeader" />

        <!-- Dashboard Content -->
        <div class="dashboard-content">
            <div id="dashboard-section">
                <!-- Stats Overview -->
                <div class="stats-grid four-col">
                    <div class="stat-card">
                        <div class="stat-icon blue">👨‍⚕️</div>
                        <div class="stat-info">
                            <h3>@Model.TotalDoctors</h3>
                            <p>Total Doctors</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">👥</div>
                        <div class="stat-info">
                            <h3>@Model.TotalPatients</h3>
                            <p>Total Patients</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">📅</div>
                        <div class="stat-info">
                            <h3>@Model.TodayAppointments</h3>
                            <p>Today's Appointments</p>
                            <small class="stat-change">@Model.TodayPendingPayments pending payment</small>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple">💰</div>
                        <div class="stat-info">
                            <h3>@Model.RevenueThisMonth.ToString("C")</h3>
                            <p>Revenue (This Month)</p>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="charts-row">
                    <div class="chart-card">
                        <div class="section-header">
                            <h2>Appointments (Last 7 Days)</h2>
                        </div>
                        <div class="chart-placeholder">
                            @foreach (var d in Model.Last7Days)
                            {
                                var pct = (int)Math.Round(d.Count * 100.0 / maxDay);
                                <div class="chart-bar" style="height: @(Math.Max(pct, 4))%" title="@d.Date.ToString("ddd, dd MMM"): @d.Count appointment(s)"></div>
                            }
                        </div>
                    </div>

                    <div class="chart-card">
                        <div class="section-header">
                            <h2>Department Distribution</h2>
                        </div>
                        @if (Model.DepartmentShares.Any())
                        {
                            <div class="department-stats">
                                @foreach (var d in Model.DepartmentShares)
                                {
                                    <div class="dept-item">
                                        <span class="dept-name">@d.Name</span>
                                        <div class="dept-bar"><div class="dept-fill" style="width: @(d.Percent)%"></div></div>
                                        <span class="dept-value">@(d.Percent)%</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="empty-state">No appointment data yet.</p>
                        }
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="content-section">
                    <div class="section-header">
                        <h2>Recent Bookings</h2>
                        <a class="btn-secondary" asp-controller="Dashboard" asp-action="AppointmentTable">View All</a>
                    </div>
                    @if (Model.RecentBookings.Any())
                    {
                        <div class="activity-list">
                            @foreach (var b in Model.RecentBookings)
                            {
                                <div class="activity-item">
                                    <div class="activity-icon @(b.Paid ? "green" : "orange")">@(b.Paid ? "✅" : "⏳")</div>
                                    <div class="activity-content">
                                        <p><strong>@b.PatientName</strong> booked with Dr. @b.DoctorName</p>
                                        <p>@b.Amount.ToString("C") - @(b.Paid ? "Paid" : "Payment pending")</p>
                                        <span class="activity-time">@b.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-state">No bookings yet.</p>
                    }
                </div>

                <!-- Quick Actions -->
                <div class="content-section">
                    <h2>Quick Actions</h2>
                    <div class="admin-actions">
                        <a class="admin-action-btn" asp-controller="Accounts" asp-action="CreateDoctor">
                            <span>➕</span><span>Add New Doctor</span>
                        </a>
                        <a class="admin-action-btn" asp-controller="ClinicBranches" asp-action="Index">
                            <span>🏥</span><span>Manage Branches</span>
                        </a>
                        <a class="admin-action-btn" asp-controller="ScheduleManagement" asp-action="Index">
                            <span>📅</span><span>Manage Schedules</span>
                        </a>
                        <a class="admin-action-btn" asp-controller="Dashboard" asp-action="AppointmentTable">
                            <span>📊</span><span>Payments &amp; Appointments</span>
                        </a>
                    </div>
                </div>
            </div><!-- /#dashboard-section -->
        </div><!-- /.dashboard-content -->
    </main>
</div><!-- /.dashboard-container -->
