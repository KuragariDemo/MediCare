@{
    ViewData["Title"] = "ForestView Hospital - Empowering Lives Through Health";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Global + Core Styles -->
    <link rel="stylesheet" href="~/css/globals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
</head>
<body>

    <partial name="_PublicHeader" />

    <!-- Hero Section -->
    <section class="hero">
        <div class="site-container">
            <div class="hero-content">
                <h1 class="hero-title">Empowering Lives Through Health</h1>
                <p class="hero-subtitle">Navigating Health Together: Your Trusted Medical Resource</p>
                <button class="cta-btn" onclick="window.location.href='@Url.Action("Index", "Appointment")'">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M10 5V15M5 10H15" stroke="white" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Book an Appointment
                </button>
            </div>
            <div class="hero-image"></div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="site-container">
            <div class="stat-card large">
                <h3>Your Bridge to Better Health<br />Start Your Journey Today</h3>
                <p class="stat-desc">Medicine Meets Technology<br />Your Online Health Hub</p>
                <div class="stat-buttons">
                    <button class="stat-btn-primary">Our waiting process</button>
                    <button class="stat-btn-secondary">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="10" stroke="#00A8A8" stroke-width="2" />
                            <path d="M10 8L14 12L10 16" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="stat-card combined">
                <div class="combined-content">
                    <div class="clients-section">
                        <h3>Our Clients</h3>
                        <div class="client-avatars">
                            <div class="avatar"></div>
                            <div class="avatar"></div>
                            <div class="avatar"></div>
                        </div>
                        <button class="view-testimonial">
                            View testimonial
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                    <div class="divider"></div>
                    <div class="stats-numbers">
                        <div class="stat-item">
                            <div class="stat-number">12K+</div>
                            <p class="stat-label">Happy clients</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="stat-card">
                <div class="progress-circle">
                    <svg width="120" height="120" viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="54" fill="none" stroke="#E0F7F4" stroke-width="8" />
                        <circle cx="60" cy="60" r="54" fill="none" stroke="#00D9A5" stroke-width="8"
                                stroke-dasharray="339.292" stroke-dashoffset="54"
                                transform="rotate(-90 60 60)" stroke-linecap="round" />
                        <text x="60" y="70" text-anchor="middle" font-size="28" font-weight="700" fill="#00A8A8">84%</text>
                    </svg>
                </div>
                <p class="stat-label">Healing Success</p>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
        <div class="site-container">
            <div class="section-header">
                <h2>Our Services</h2>
                <h3>Comprehensive Medical Solutions</h3>
            </div>

            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                            <circle cx="24" cy="24" r="20" stroke="#00A8A8" stroke-width="2" />
                            <path d="M24 14V34M14 24H34" stroke="#00A8A8" stroke-width="2" />
                        </svg>
                    </div>
                    <h4>Cardiology</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>

                <div class="service-card featured">
                    <div class="service-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                            <circle cx="24" cy="24" r="20" stroke="#00A8A8" stroke-width="2" />
                            <path d="M20 20H28M20 24H28M20 28H24" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <h4>Dentistry</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                            <circle cx="24" cy="24" r="20" stroke="#00A8A8" stroke-width="2" />
                            <path d="M18 24C18 24 20 20 24 20C28 20 30 24 30 24" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <h4>Neurology</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>
            </div>

            <div class="carousel-dots">
                <button class="dot"></button>
                <button class="dot active"></button>
                <button class="dot"></button>
            </div>
        </div>
    </section>

    <!-- Steps Section -->
    <section class="steps-section">
        <div class="site-container">
            <div class="section-header">
                <h2>4 Easy steps And Get Your Solution</h2>
                <p>Navigating Health Together: Your Trusted Medical Resource.Medicine Meets Technology Your Online Health Hub</p>
            </div>

            <div class="steps-grid">
                <div class="step-card featured">
                    <div class="step-icon">
                        <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                            <circle cx="32" cy="24" r="8" stroke="currentColor" stroke-width="2" />
                            <path d="M20 44C20 38 25 34 32 34C39 34 44 38 44 44" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <h4>Check Doctor Profile</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>

                <div class="step-card">
                    <div class="step-icon">
                        <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                            <path d="M24 28H40M24 36H32" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <rect x="20" y="20" width="24" height="28" rx="2" stroke="currentColor" stroke-width="2" />
                        </svg>
                    </div>
                    <h4>Request Consultation</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>

                <div class="step-card">
                    <div class="step-icon">
                        <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                            <rect x="20" y="24" width="24" height="20" rx="2" stroke="currentColor" stroke-width="2" />
                            <path d="M26 24V20M38 24V20M20 30H44" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <h4>Schedule Meeting</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>

                <div class="step-card">
                    <div class="step-icon">
                        <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                            <path d="M28 36L32 40L40 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <circle cx="32" cy="32" r="12" stroke="currentColor" stroke-width="2" />
                        </svg>
                    </div>
                    <h4>Get Your Solution</h4>
                    <p>Navigating Health Together Your Trusted Medical Resource. Medicine Meets Technology Your Online Health Hub.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Doctors Section -->
    <section class="doctors-section">
        <div class="site-container">
            <div class="section-header">
                <h2>Meet Our Doctors</h2>
                <h3>We're Dedicated To Your Well-Being</h3>

                <form class="search-bar-container" asp-controller="Appointment" asp-action="Index" method="get">
                    <div class="search-bar">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="search-icon">
                            <circle cx="9" cy="9" r="6" stroke="#00A8A8" stroke-width="2" />
                            <path d="M13 13L17 17" stroke="#00A8A8" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        <input type="text" name="q" placeholder="Search doctors by name or specialty..." class="search-input">
                        <button type="submit" class="search-btn" title="Find a doctor">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <circle cx="9" cy="9" r="6" stroke="white" stroke-width="2" />
                                <path d="M13 13L17 17" stroke="white" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                </form>
            </div>

            @{
                var featuredDoctors = (IEnumerable<dynamic>)(ViewBag.FeaturedDoctors ?? Array.Empty<object>());
            }
            @if (featuredDoctors.Any())
            {
                <div class="doctors-carousel">
                    <div class="doctors-grid">
                        @foreach (var doc in featuredDoctors)
                        {
                            <a class="doctor-card" asp-controller="Appointment" asp-action="Index" style="text-decoration:none;color:inherit;">
                                <div class="doctor-image"></div>
                                <h4>Dr. @doc.Name</h4>
                                <p>@doc.Specialty</p>
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <p style="text-align:center;color:#6b7280;">Doctors will appear here once they're added to the system.</p>
            }
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter-section">
        <div class="site-container">
            <h2>Get the Latest Health Updates</h2>
            <div class="newsletter-form">
                <input type="email" placeholder="Enter your email..." class="email-input">
                <button class="subscribe-btn">Subscribe</button>
            </div>
        </div>
    </section>

    <partial name="_PublicFooter" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
