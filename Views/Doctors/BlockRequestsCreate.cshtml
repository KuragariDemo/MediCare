@model MediCare.ViewModels.Schedule.BlockRequestVm
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="dashboard-container">
    @* Optional: doctor sidebar *@

    <main class="dashboard-main">
        <h2>Request Time Block</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert danger">@TempData["Error"]</div>
        }

        <div class="content-section">
            <form asp-action="Create" method="post" class="profile-details" style="max-width:600px;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DoctorId" />

                <div class="detail-row">
                    <span class="detail-label">Date</span>
                    <span class="detail-value">
                        <input asp-for="Date" class="form-input" type="date" />
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Start</span>
                    <span class="detail-value">
                        <input asp-for="StartTime" class="form-input" type="time" />
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">End</span>
                    <span class="detail-value">
                        <input asp-for="EndTime" class="form-input" type="time" />
                    </span>
                </div>

                <div class="detail-row full-width">
                    <button type="submit" class="btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </main>
</div>
