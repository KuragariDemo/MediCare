@using Microsoft.AspNetCore.Identity
@using MediCare.App.Models
@model MediCare.App.ViewModels.Doctor.DoctorDashboardVM
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Doctor Dashboard";

    var doctorName = ViewBag.DoctorName as string ?? "Doctor";
    var doctorRole = ViewBag.Speciality as string ?? "Specialist";
}

<div class="dashboard-container">
    <!-- Sidebar partial -->
    <partial name="_DoctorSidebar" />

    <!-- Main Content -->
    <main class="dashboard-main">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="header-left">
                <h1>Welcome, @doctorName!</h1>
                <p>Here's your schedule and patient updates for today</p>
            </div>
            <div class="header-right">
                <div class="user-profile">
                    <div class="user-avatar">👨‍⚕️</div>
                    <div class="user-info">
                        <p class="user-name">@doctorName</p>
                        <p class="user-role">@doctorRole</p>
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="dashboard-content">
            <section id="home-section">
                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue">📅</div>
                        <div class="stat-info">
                            <h3>@Model.TodayCount</h3>
                            <p>Today's Appointments</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">✅</div>
                        <div class="stat-info">
                            <h3>@Model.TodayCompletedCount</h3>
                            <p>Completed Today</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">⏳</div>
                        <div class="stat-info">
                            <h3>@Model.TodayUpcomingCount</h3>
                            <p>Remaining Today</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple">👥</div>
                        <div class="stat-info">
                            <h3>@Model.TotalPatientsCount</h3>
                            <p>Total Patients</p>
                        </div>
                    </div>
                </div>

                <!-- Today's Schedule -->
                <div class="content-section">
                    <div class="section-header">
                        <h2>Today's Schedule</h2>
                        <a class="btn-primary" asp-controller="DoctorSchedule" asp-action="Index">View Full Calendar</a>
                    </div>
                    @if (Model.TodaySchedule.Any())
                    {
                        <div class="schedule-timeline">
                            @foreach (var item in Model.TodaySchedule)
                            {
                                <div class="timeline-item @(item.IsInProgress ? "active" : "")">
                                    <div class="timeline-time">@item.StartTime.ToString(@"hh\:mm")</div>
                                    <div class="timeline-content">
                                        <h4>@item.PatientName</h4>
                                        <p>@(string.IsNullOrWhiteSpace(item.ReasonNote) ? "No reason provided" : item.ReasonNote)</p>
                                        @if (item.IsCompleted)
                                        {
                                            <span class="status-badge stable">Completed</span>
                                        }
                                        else if (item.IsInProgress)
                                        {
                                            <span class="status-badge in-progress">In Progress</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge pending">Upcoming</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-state">No appointments scheduled for today.</p>
                    }
                </div>

                <!-- Recent Patients -->
                <div class="content-section">
                    <div class="section-header">
                        <h2>Recent Patients</h2>
                        <a class="btn-secondary" asp-controller="DoctorPatients" asp-action="Records">View All</a>
                    </div>
                    @if (Model.RecentPatients.Any())
                    {
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Patient Name</th>
                                        <th>Last Visit</th>
                                        <th>Reason for Visit</th>
                                        <th>Payment</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.RecentPatients)
                                    {
                                        <tr>
                                            <td>
                                                <div class="patient-cell">
                                                    <div class="patient-avatar">@(p.PatientName.Length > 0 ? p.PatientName.Substring(0, 1).ToUpper() : "P")</div>
                                                    <span>@p.PatientName</span>
                                                </div>
                                            </td>
                                            <td>@p.LastVisit.ToString("MMM dd, yyyy")</td>
                                            <td>@(string.IsNullOrWhiteSpace(p.ReasonNote) ? "—" : p.ReasonNote)</td>
                                            <td><span class="status-badge @(p.Paid ? "stable" : "pending")">@(p.Paid ? "Paid" : "Unpaid")</span></td>
                                            <td><a class="action-btn" asp-controller="DoctorPatients" asp-action="Records">View</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="empty-state">No patients yet.</p>
                    }
                </div>
            </section>
        </div>
    </main>
</div>
