@model IEnumerable<MediCare.App.Models.Doctor>
@using MediCare.App.Models
@{
    ViewData["Title"] = "Clinic Branches Management";
    Layout = "_AdminLayout";
}

@functions {
    public string AntiXsrf()
    {
        var antiForgery = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Antiforgery.IAntiforgery))
            as Microsoft.AspNetCore.Antiforgery.IAntiforgery;
        return antiForgery!.GetAndStoreTokens(Context).RequestToken!;
    }
}
<meta name="request-verification-token" content="@AntiXsrf()" />

<div class="dashboard-container">
    @await Html.PartialAsync("_AdminSidebar")

    <main class="dashboard-main">
        <!-- HEADER -->
        <header class="dashboard-header">
            <div class="header-left">
                <h1>Admin Dashboard</h1>
                <p>Hospital Management Overview</p>
            </div>
            <div class="header-right">
                <button class="notification-btn">
                    <span>🔔</span>
                    <span class="notification-badge">8</span>
                </button>
                <div class="user-profile">
                    <div class="user-avatar">AD</div>
                    <div class="user-info">
                        <p class="user-name">Admin User</p>
                        <p class="user-role">System Administrator</p>
                    </div>
                </div>
            </div>
        </header>

        <!-- PANEL HEADER -->
        <div class="panel-header">
            <h2>Doctor Account Management</h2>
            <button class="btn btn-primary" type="button" onclick="openModal('createDoctor')">
                <span>➕</span>
                <span>Create New Doctor Account</span>
            </button>
        </div>

        <!-- SEARCH BAR -->
        <div class="search-container">
            <span class="search-icon">🔍</span>
            <input type="text" id="doctorSearch" class="form-input" placeholder="Search doctors by name or email...">
        </div>

        <!-- DOCTOR LIST -->
        <div class="admin-account-list" id="doctorAccountList">
            @if (!(Model?.Any() ?? false))
            {
                <div class="empty-state" id="emptyDoctorState"
                     style="text-align:center;padding:20px;border:2px dashed var(--color-border-light);
                                border-radius:16px;background:white;">
                    <div class="empty-state-icon" style="font-size:38px;">🩺</div>
                    <h3>No Doctors Found</h3>
                    <p>Click 'Create New Doctor Account' to add your first doctor.</p>
                </div>
            }
            else
            {
                foreach (var d in Model!)
                {
                    <div class="admin-account-item"
                         data-name="@d.User.FullName"
                         data-email="@d.User.Email">
                        <div class="admin-info">
                            <div class="admin-info-header">
                                <h4>@(d.User.FullName ?? "(no name)")</h4>
                                <span class="admin-role-badge role-admin">Doctor</span>
                            </div>
                            <p>
                                @d.User.Email |
                                Specialty: @(d.Speciality ?? "Not Assigned") |
                                Created: @d.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </p>
                        </div>

                        <div class="admin-actions">
                            <!-- Delete Doctor -->
                            <form asp-action="DeleteDoctor"
                                  asp-controller="Accounts"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this doctor account?');"
                                  style="display:flex;gap:6px;align-items:flex-start;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.Id" />
                                <button class="btn btn-danger" type="submit"
                                        style="background:#ff4d4d; border:none; color:#fff; font-weight:600;
                                                       padding:6px 12px; border-radius:8px;">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </main>
</div>

<!-- CREATE DOCTOR MODAL -->
<div class="modal" id="doctorModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">Create Doctor Account</h3>
            <button class="close-modal-btn" onclick="closeModal('doctorModal')" aria-label="Close">❌</button>
        </div>

        <form id="doctorForm" asp-action="CreateDoctor" asp-controller="Accounts" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="doctorName">Full Name</label>
                <input type="text" id="doctorName" name="FullName" class="form-input" placeholder="Dr. John Doe" required />
            </div>

            <div class="form-group">
                <label for="doctorEmail">Email Address</label>
                <input type="email" id="doctorEmail" name="Email" class="form-input" placeholder="john.doe@hospital.com" required />
            </div>

            <div class="form-group">
                <label for="specialty">Specialty</label>
                <select id="specialty" name="SpecialtyId" class="form-select" required>
                    <option value="">Select Specialty</option>
                    @if (ViewBag.Specialties != null)
                    {
                        foreach (var s in (IEnumerable<SelectListItem>)ViewBag.Specialties)
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group full-width">
                <label for="doctorBio">Biography</label>
                <textarea id="doctorBio" name="Bio" class="form-textarea" placeholder="Enter doctor's biography..."></textarea>
            </div>

            <div class="form-group">
                <label for="doctorPassword">Password</label>
                <input type="password" id="doctorPassword" name="Password" class="form-input" placeholder="Min 8 characters" minlength="8" required />
            </div>

            <div class="form-group">
                <label for="doctorConfirmPassword">Confirm Password</label>
                <input type="password" id="doctorConfirmPassword" name="ConfirmPassword" class="form-input" required />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('doctorModal')">
                    <span>↩️</span>
                    <span>Cancel</span>
                </button>
                <button type="submit" class="btn btn-primary">
                    <span>✅</span>
                    <span>Create Account</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // --- Search Filter ---
        const searchInput = document.getElementById('doctorSearch');
        const list = document.getElementById('doctorAccountList');

        function filterList() {
            const q = (searchInput.value || '').toLowerCase();
            const items = list.querySelectorAll('.admin-account-item');
            let shown = 0;
            items.forEach(it => {
                const name = (it.getAttribute('data-name') || '').toLowerCase();
                const email = (it.getAttribute('data-email') || '').toLowerCase();
                const match = !q || name.includes(q) || email.includes(q);
                it.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            const emptyState = document.getElementById('emptyDoctorState');
            if (!items.length || shown === 0) {
                if (emptyState) emptyState.style.display = 'block';
            } else if (emptyState) {
                emptyState.style.display = 'none';
            }
        }

        searchInput?.addEventListener('keyup', filterList);

        // --- Modal ---
        const openModal = (mode) => {
            document.getElementById('doctorForm').reset();
            document.getElementById('modalTitle').textContent = 'Create Doctor Account';
            document.getElementById('doctorModal').classList.add('visible');
        };
        const closeModal = (id) => {
            document.getElementById(id).classList.remove('visible');
        };

        // Close modal when clicking outside
        document.getElementById('doctorModal')?.addEventListener('click', (e) => {
            if (e.target.id === 'doctorModal') closeModal('doctorModal');
        });
    </script>
}
