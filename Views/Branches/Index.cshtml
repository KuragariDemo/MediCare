@model List<MediCare.Models.ClinicBranch>
@{
    ViewData["Title"] = "Our Branches - ForestView Hospital";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/globals.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/branches.css" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <partial name="_PublicHeader" />

    <!-- Branches Hero -->
    <section class="page-hero">
        <div class="container">
            <h1>Our Clinic Branches</h1>
            <p>Find a ForestView Hospital location near you</p>
        </div>
    </section>

    <!-- Branches Section -->
    <section class="branches-section">
        <div class="container">
            @if (Model.Any())
            {
                <div class="branches-grid">
                    @foreach (var b in Model)
                    {
                        <div class="branch-card-detail">
                            <div class="branch-header">
                                <h2>@b.Name</h2>
                            </div>

                            <div class="branch-image-placeholder">
                                <div class="branch-placeholder-icon">🏥</div>
                            </div>

                            <div class="branch-details">
                                @if (!string.IsNullOrWhiteSpace(b.Address))
                                {
                                    <div class="detail-item">
                                        <div class="detail-icon">📍</div>
                                        <div class="detail-content">
                                            <h4>Address</h4>
                                            <p>@b.Address</p>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(b.Phone))
                                {
                                    <div class="detail-item">
                                        <div class="detail-icon">📞</div>
                                        <div class="detail-content">
                                            <h4>Phone</h4>
                                            <p>@b.Phone</p>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(b.Email))
                                {
                                    <div class="detail-item">
                                        <div class="detail-icon">✉️</div>
                                        <div class="detail-content">
                                            <h4>Email</h4>
                                            <p>@b.Email</p>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="branch-actions">
                                <a class="branch-btn primary" asp-controller="Appointment" asp-action="Index">Book Appointment</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="text-align:center;color:#6b7280;">No branches are listed yet. Please check back soon.</p>
            }
        </div>
    </section>

    <partial name="_PublicFooter" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
